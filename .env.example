# ==============================================================================
# Variables de entorno - Crypto Market ETL con Apache Airflow
# Copia este archivo como `.env` y reemplaza los valores antes de iniciar Docker.
# Nunca subas el archivo `.env` real a Git.
# ==============================================================================

# PostgreSQL (base de metadatos de Airflow y base analítica DW)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=airflow
DW_DB=crypto_dw
POSTGRES_HOST_PORT=5433

# Clave Fernet para cifrar conexiones y variables en Airflow.
# Genera una clave segura ejecutando:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=replace_with_generated_fernet_key

# Usuario administrador inicial de Apache Airflow (usado por airflow-init)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin_password
AIRFLOW_ADMIN_EMAIL=admin@example.com
